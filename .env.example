# Database connection string (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth Secret for authentication sessions
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Cloudinary Configuration (Cloud Image Hosting & Media Storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
